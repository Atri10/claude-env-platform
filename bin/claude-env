#!/usr/bin/env python3
"""claude-env :: top-level CLI dispatcher.

Runs every platform script through the venv Python ($CLAUDE_ENV_HOME/venv/bin/python)
so the correct, isolated set of dependencies is always used — even when the CLI
itself was invoked with a different Python.  Falls back to the current interpreter
only if the venv does not exist (e.g. before bootstrap has been run).

Help:
    claude-env                 show grouped command overview
    claude-env help [command]  overview, or one command's summary
    claude-env <command> --help detailed options for that command
"""
import os, sys, subprocess
from pathlib import Path

H = Path(os.environ.get("CLAUDE_ENV_HOME", str(Path.home() / ".claude-env")))
ROOT = Path(__file__).resolve().parents[1]

# Always dispatch via the venv Python so all platform deps are available.
_venv_py = H / "venv" / "bin" / "python"
PYTHON = str(_venv_py) if _venv_py.exists() else sys.executable

CMDS = {
    "bootstrap":    ROOT / "bootstrap.py",
    "scan":         ROOT / "rag" / "repository_scan.py",
    "index":        ROOT / "rag" / "bootstrap_rag.py",
    "reindex":      ROOT / "rag" / "incremental_index.py",
    "dashboard":    ROOT / "observability" / "dashboard.py",
    "approvals":    ROOT / "agents" / "orchestration" / "approval_gate.py",
    "approvals-ui": ROOT / "agents" / "orchestration" / "approvals_ui.py",
    "services":     ROOT / "scripts" / "services_cli.py",
    "route":        ROOT / "agents" / "orchestration" / "task_router.py",
    "register":     ROOT / "scripts" / "register_repo.py",
    "onboard":      ROOT / "scripts" / "register_repo.py",
    "report":       ROOT / "audit" / "compliance_report.py",
    "replay":       ROOT / "audit" / "session_replay.py",
    "incident":     ROOT / "security" / "incident.py",
    "policy-sim":   ROOT / "security" / "policy_sim.py",
    "hooks":        ROOT / "hooks" / "install_hooks.py",
    "know":         ROOT / "rag" / "pipelines" / "know.py",
    "context-pack": ROOT / "rag" / "context_pack.py",
    "rag-bench":    ROOT / "rag" / "rag_bench.py",
    "test-impact":  ROOT / "rag" / "test_impact.py",
    "doc-drift":    ROOT / "rag" / "doc_drift.py",
    "digest":       ROOT / "agents" / "analysts" / "nightly_analyst.py",
    "ingest-sessions": ROOT / "memory" / "session_ingestor.py",
    "memory-sync":  ROOT / "memory" / "memory_sync.py",
    "budget":       ROOT / "observability" / "budgets.py",
}
VALIDATORS = ["installation", "security", "rag", "memory", "agents", "mcp", "features"]

# One-line description per command, grouped for a readable overview.
# (Keep in sync with CMDS; "validate" is handled specially below.)
GROUPS = [
    ("Setup & install", [
        ("bootstrap",   "Create/refresh the platform: venv, deps, DB, policies, code mirror."),
        ("hooks",       "Install / preview / remove the native-tool policy + audit hooks."),
    ]),
    ("Onboard a repository", [
        ("onboard",     "Onboard a repo: policy, RAG/memory namespaces, MCP env, template (interactive)."),
        ("register",    "Same as `onboard` (use --yes for non-interactive)."),
        ("scan",        "Preview which files the policy would index vs block (no model load)."),
        ("index",       "Build the full RAG index for a repo."),
        ("reindex",     "Incrementally re-index changed files (used by the post-commit hook)."),
    ]),
    ("Knowledge & quality", [
        ("know",        "Fused recall over memory + RAG + git, with provenance."),
        ("context-pack","Generate CLAUDE.generated.md from repo signals + team memory."),
        ("rag-bench",   "Golden-query recall@k / MRR — gate embedding-model swaps."),
        ("test-impact", "Map changed files to the minimal set of tests to run."),
        ("doc-drift",   "Find docs that reference missing or stale code."),
        ("digest",      "Repo-health digest (TODO aging, dead symbols, doc drift)."),
    ]),
    ("Approvals & governance", [
        ("approvals",   "List / resolve pending human approvals."),
        ("approvals-ui","Local web UI to approve/deny (auto-opens; picks a free port)."),
        ("report",      "Auditor-ready compliance evidence + hash-chain proof."),
        ("replay",      "Step-by-step forensic timeline of a session."),
        ("incident",    "Kill switch: freeze everything closed / lift (on|off|status)."),
        ("policy-sim",  "Dry-run a candidate policy / diff it against a baseline."),
    ]),
    ("Operations", [
        ("services",    "List the running local UI servers and their ports/URLs."),
        ("dashboard",   "Local metrics summary, or `serve` a read-only Datasette UI."),
        ("budget",      "Per-repo monthly cost budgets (exit 1 on exceed)."),
        ("ingest-sessions", "Ingest Claude Code transcripts into episodic memory."),
        ("memory-sync", "Export / import a memory namespace (secret-redacted JSONL)."),
        ("route",       "Route a task to a specialist agent (orchestrator)."),
    ]),
    ("Diagnostics", [
        ("validate",    "Run platform validators (all | " + " | ".join(VALIDATORS) + ")."),
    ]),
]
DESC = {cmd: desc for _, cmds in GROUPS for cmd, desc in cmds}


def usage() -> None:
    print("claude-env — local governance layer for Claude Code\n")
    print("usage: claude-env <command> [options]\n")
    width = max(len(c) for c in DESC)
    for title, cmds in GROUPS:
        print(f"{title}:")
        for cmd, desc in cmds:
            print(f"  {cmd:<{width}}  {desc}")
        print()
    print("Help:")
    print(f"  {'help [command]':<{width}}  this overview, or one command's summary")
    print(f"  {'<command> --help':<{width}}  detailed options for a command")
    print(f"\n  venv: {PYTHON}")


def cmd_help(name: str) -> int:
    """Curated one-line summary for a command + how to see full options."""
    if not name or name in ("help", "-h", "--help"):
        usage(); return 0
    if name not in DESC:
        print(f"unknown command: {name}\n", file=sys.stderr)
        usage(); return 2
    print(f"claude-env {name} — {DESC[name]}")
    if name == "validate":
        print("  usage: claude-env validate [all|" + "|".join(VALIDATORS) + "]")
    else:
        print(f"  options: claude-env {name} --help")
    return 0


def main() -> int:
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        usage(); return 0 if len(sys.argv) < 2 else 0
    cmd, rest = sys.argv[1], sys.argv[2:]

    if cmd == "help":
        return cmd_help(rest[0] if rest else "")

    if cmd == "validate":
        which = rest[0] if rest else "all"
        targets = VALIDATORS if which == "all" else [which]
        rc = 0
        for v in targets:
            script = (ROOT / "rag" / "validate_rag.py") if v == "rag" \
                     else (ROOT / "validation" / f"validate_{v}.py")
            args = rest[1:] if v == "rag" else []
            rc |= subprocess.run([PYTHON, str(script), *args]).returncode
        return rc

    if cmd in CMDS:
        return subprocess.run([PYTHON, str(CMDS[cmd]), *rest]).returncode

    print(f"unknown command: {cmd}\n", file=sys.stderr)
    usage()
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
