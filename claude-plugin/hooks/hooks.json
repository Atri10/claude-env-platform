{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|NotebookEdit|Glob|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_ENV_HOME:-$HOME/.claude-env}/venv/bin/python ${CLAUDE_ENV_HOME:-$HOME/.claude-env}/hooks/policy_hook.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_ENV_HOME:-$HOME/.claude-env}/venv/bin/python ${CLAUDE_ENV_HOME:-$HOME/.claude-env}/hooks/audit_hook.py"
          }
        ]
      }
    ]
  }
}
