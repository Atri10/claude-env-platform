# claude-env :: nightly maintenance (Linux equivalent of the launchd job)
# Install (user units — no root needed):
#   mkdir -p ~/.config/systemd/user
#   cp scripts/systemd/claude-env-nightly.{service,timer} ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now claude-env-nightly.timer
# Logs: journalctl --user -u claude-env-nightly  (plus ~/.claude-env/logs/memory.log)

[Unit]
Description=claude-env nightly memory maintenance, transcript ingestion, repo digests

[Service]
Type=oneshot
ExecStart=/bin/sh -c '"$HOME/.claude-env/scripts/nightly_memory.sh"'

[Install]
WantedBy=default.target
