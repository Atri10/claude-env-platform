{
  "mcpServers": {
    "claude-env-filesystem-policy": {
      "command": "${CLAUDE_ENV_HOME:-$HOME/.claude-env}/venv/bin/python",
      "args": ["${CLAUDE_ENV_HOME:-$HOME/.claude-env}/mcp-servers/filesystem-policy/server.py"],
      "env": {"CLAUDE_ENV_REPO_ROOT": "${workspaceFolder}"}
    },
    "claude-env-git": {
      "command": "${CLAUDE_ENV_HOME:-$HOME/.claude-env}/venv/bin/python",
      "args": ["${CLAUDE_ENV_HOME:-$HOME/.claude-env}/mcp-servers/git/server.py"],
      "env": {"CLAUDE_ENV_REPO_ROOT": "${workspaceFolder}"}
    },
    "claude-env-rag": {
      "command": "${CLAUDE_ENV_HOME:-$HOME/.claude-env}/venv/bin/python",
      "args": ["${CLAUDE_ENV_HOME:-$HOME/.claude-env}/mcp-servers/lancedb-rag/server.py"],
      "env": {"CLAUDE_ENV_REPO_ROOT": "${workspaceFolder}"}
    },
    "claude-env-memory": {
      "command": "${CLAUDE_ENV_HOME:-$HOME/.claude-env}/venv/bin/python",
      "args": ["${CLAUDE_ENV_HOME:-$HOME/.claude-env}/mcp-servers/memory-graph/server.py"],
      "env": {"CLAUDE_ENV_REPO_ROOT": "${workspaceFolder}"}
    }
  }
}
