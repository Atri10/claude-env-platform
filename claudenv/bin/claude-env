#!/usr/bin/env python3
"""
claude-env :: CLI entry point (installed into $CLAUDE_ENV_HOME/bin)
Thin wrapper that delegates to claudenv.cli module.
"""
from __future__ import annotations

import os
import sys
from pathlib import Path

# Ensure claudenv is on the path
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from claudenv.cli import cli

if __name__ == "__main__":
    cli()